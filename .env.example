# Clave de la API de Pixabay (https://pixabay.com/api/docs/). Si se deja vacía, la app funciona en MODO DEMO.
PIXABAY_API_KEY=

# Cadena de conexión a MongoDB (local o Atlas).
# Si no se puede conectar, se usa una base MongoDB en memoria (los datos se pierden al reiniciar).
MONGODB_URI=mongodb://127.0.0.1:27017/pixabay_sesgos

PORT=3000
